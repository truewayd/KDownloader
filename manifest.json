{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "cookies",
    "downloads",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://coomer.st/*",
    "https://kemono.cr/*",
    "https://coomerfans.com/*",
    "https://*.coomer.st/*",
    "https://*.kemono.cr/*",
    "https://*.coomerfans.com/*",
    "https://pawchive.pw/*",
    "https://file.pawchive.pw/*",
    "https://api.github.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://pawchive.pw/*"],
      "js": ["content/paw_api_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://coomer.st/*", "https://kemono.cr/*"],
      "js": ["content/injector.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://coomer.st/*/user/*/post/*",
        "https://kemono.cr/*/user/*/post/*",
        "https://coomer.st/*/user/*",
        "https://kemono.cr/*/user/*"
      ],
      "js": [
        "content/helpers.js",
        "shared/i18n.js",
        "content/ui.js",
        "content/download.js",
        "content/router.js",
        "content/actions.js"
      ],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://coomer.st/*/account/favorites/artists*",
        "https://kemono.cr/*/account/favorites/artists*"
      ],
      "js": ["content/helpers.js", "shared/i18n.js", "content/ui.js", "content/router.js", "content/flag/index.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://pawchive.pw/*/user/*"
      ],
      "js": [
        "content/helpers.js",
        "shared/i18n.js",
        "content/ui.js",
        "content/download.js",
        "content/router.js",
        "content/paw_actions.js"
      ],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://coomerfans.com/u/*",
        "https://coomerfans.com/p/*",
        "https://*.coomerfans.com/u/*",
        "https://*.coomerfans.com/p/*"
      ],
      "js": [
        "content/helpers.js",
        "shared/i18n.js",
        "content/ui.js",
        "content/download.js",
        "content/router.js",
        "content/coomerfans_actions.js"
      ],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["injected/creators_page.js"],
      "matches": ["https://coomer.st/*", "https://kemono.cr/*"]
    }
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrueDown",
  "version": "../../manifest.json",
  "identifier": "io.truewayd.truedown",
  "build": {
    "beforeDevCommand": "node ../tools/prepare-desktop.mjs",
    "beforeBuildCommand": "node ../tools/prepare-desktop.mjs",
    "frontendDist": "../dist/desktop-web"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TrueDown",
        "width": 1200,
        "height": 820,
        "minWidth": 620,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/truedown-core",
      "binaries/truedown-cli"
    ],
    "icon": [
      "../windows/truedown.ico",
      "../macos/truedown.icns"
    ],
    "resources": {
      "../ARIA2_COPYING": "ARIA2_COPYING",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    }
  }
}
